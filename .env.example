# StudyMate — Netlify Environment Variables
# Copy these variable names into your Netlify site settings:
# Site Settings → Environment Variables

# Azure Storage Account Name
AZURE_STORAGE_ACCOUNT_NAME=myresearchdata

# Azure Storage Account Key (from Azure Portal → Storage Account → Access Keys)
AZURE_STORAGE_ACCOUNT_KEY=<YOUR_AZURE_STORAGE_ACCOUNT_KEY>

# Azure Storage Connection String (optional — used if you extend to Blob SDK)
AZURE_STORAGE_CONNECTION_STRING=<YOUR_AZURE_CONNECTION_STRING>

# Passkeys are bound to this origin. Production default is the existing Netlify URL.
# For local development, set to the actual localhost origin used by Netlify Dev.
APP_ORIGIN=https://mystudyfriends.netlify.app

# Optional: stable private pepper for email lookup hashes (otherwise uses the storage key).
# Set before launch if you want to rotate storage keys independently in future.
# AUTH_EMAIL_PEPPER=<a-long-random-server-only-secret>
